{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RobertAgterhuis/speckit-azure-interview/templates/azure-design-review.schema.json",
  "title": "Azure Intended Design Review",
  "description": "Records an explicit human approval or rejection of one exact intended-state Azure design.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reviewStatus",
    "designModel",
    "designDigest",
    "reviewedBy",
    "reviewedAt",
    "findings",
    "implementationAuthorized"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "reviewStatus": {
      "type": "string",
      "enum": [
        "approved",
        "rejected"
      ]
    },
    "designModel": {
      "type": "string",
      "const": ".specify/design/azure-design-model.json"
    },
    "designDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "sha256"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "reviewedBy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S"
    },
    "reviewedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "comment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "\\S"
    },
    "findings": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000,
        "pattern": "\\S"
      }
    },
    "implementationAuthorized": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "reviewStatus": {
            "const": "approved"
          }
        },
        "required": [
          "reviewStatus"
        ]
      },
      "then": {
        "properties": {
          "findings": {
            "maxItems": 0
          },
          "implementationAuthorized": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reviewStatus": {
            "const": "rejected"
          }
        },
        "required": [
          "reviewStatus"
        ]
      },
      "then": {
        "properties": {
          "findings": {
            "minItems": 1
          },
          "implementationAuthorized": {
            "const": false
          }
        }
      }
    }
  ]
}
